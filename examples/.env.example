# Copy to .env locally. Never commit real values.
WHATSAPP_GROUP_NAME=Attendance Group
BROWSER_PROFILE_DIR=.whatsapp-profile
ROSTER_FILE=config/employees.json
LEDGER_FILE=data/attendance-ledger.json
REPORTS_DIR=reports
TIMEZONE=Asia/Karachi

# Optional: assists with ambiguous message interpretation and report narratives.
AI_API_KEY=replace-with-your-api-key
AI_MODEL=replace-with-your-model-name

# Gmail OAuth desktop application and HR delivery target.
GMAIL_CLIENT_ID=replace-with-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-oauth-client-secret
HR_EMAIL=hr@example.com
